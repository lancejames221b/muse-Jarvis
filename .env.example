# --- required ---
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here
ALLOWED_USERS=your_discord_user_id_here
ALERT_WEBHOOK_TOKEN=generate_a_long_random_string_here
STT_URL=http://localhost:8765
CHATTERBOX_URL=http://localhost:7861

# --- optional ---
# Pin the bot to one voice channel; blank = follow the owner between channels.
DISCORD_VOICE_CHANNEL_ID=
# Main text channel for fallback + typed input; blank = owner DM fallback.
DISCORD_TEXT_CHANNEL_ID=
ALERT_WEBHOOK_PORT=3335
# CHATTERBOX_FALLBACK_URL=
# CHATTERBOX_VOICE=jarvis
# JARVIS_LISTEN_WINDOW_MS=30000
# JARVIS_CONVERSATION_MODE_ENABLED=true
# Transcript ticker: post every Jarvis-addressed utterance to the voice
# channel's text chat so you can see you're heard. Set false to disable.
# JARVIS_TRANSCRIPT_FEED=true
# BORDERLINE_CONFIDENCE=0.55
# VAD_TIMEOUT=1500
# UTTERANCE_DEBOUNCE_MS=0
# Typed text input (DMs, main channel, voice-channel chat) + /send-text.
# TEXT_ENABLED=true
# Bind address for the HTTP API. Loopback-only by default; set to '::' to
# expose the API on your LAN (still Bearer-token guarded).
# HTTP_HOST=127.0.0.1
# Log verbosity: debug, info, warn, error.
# LOG_LEVEL=info
# Optional "id:name,id:name" display names for the allowed-users list.
# JARVIS_USER_NAMES=
